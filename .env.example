# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Provider (Phase 3: Ollama only). Model names are configuration, never code.
PSEUDONYM_PROVIDER=ollama
# Required. Clients must send this exact name as "model" (ADR-014). The
# demo model: a 4B instruct model that runs on a CPU (ADR-017 measured it).
PSEUDONYM_MODEL=qwen3:4b-instruct-2507-q4_K_M
PSEUDONYM_PROVIDER_BASE_URL=http://localhost:11434/v1
# Local Ollama ignores the key; set one only for a hosted endpoint.
# PSEUDONYM_PROVIDER_API_KEY=
# Non-streaming: the whole call. Streaming: each wait (headers, next piece).
PSEUDONYM_PROVIDER_TIMEOUT_MS=120000

# Request body limit in bytes (ADR-015): 256 KiB. With person names on, it
# also bounds how long the name model works on one request; raising it
# changes two names decisions (ADR-037, step 4b; see env.ts).
PSEUDONYM_MAX_BODY_BYTES=262144
# Provider response limit in bytes when not streaming (ADR-020): 1 MiB.
PSEUDONYM_MAX_RESPONSE_BYTES=1048576
# Provider response limit in bytes when streaming (ADR-020): 32 MiB, counted
# on the wire. Each streamed token, reasoning included, is a chunk of about
# 200 to 250 bytes, so this is about 130,000 to 160,000 tokens.
PSEUDONYM_MAX_STREAM_BYTES=33554432
# Restore placeholders inside URLs, link targets and HTML attributes too.
# Leave false: see "Restoration safety" in the README.
PSEUDONYM_RESTORE_IN_UNSAFE_REGIONS=false
# Ask the model to copy placeholders exactly (ADR-017). Off by default: on
# the demo model it did not help (15 tasks, 34 values per setting).
PSEUDONYM_PLACEHOLDER_INSTRUCTION=false
# Person names (ADR-035, ADR-037). Off by default: slow (about 0.3 s per
# KiB of text on a laptop CPU) and with false positives. With true the
# gateway needs the model files (npm run fetch:model) and the runtime (the
# default npm install), and refuses to start without them.
PSEUDONYM_NAMES=false
# With names on only: how long a request may wait for its names (queued and
# running together), and how many requests may wait while the model works.
# A request over either limit gets a 503; it is never sent without names.
# PSEUDONYM_NAMES_TIMEOUT_MS=202000
# PSEUDONYM_NAMES_MAX_QUEUE=8
